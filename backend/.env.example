# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB - use a local instance or a free MongoDB Atlas cluster
# Local example:   mongodb://127.0.0.1:27017/hrms
# Atlas example:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hrms
MONGO_URI=mongodb://127.0.0.1:27017/hrms

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (optional - leave blank to simulate/log emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HRMS <no-reply@hrms.local>"

# SMS / Voice call via Twilio (optional - leave blank to simulate/log instead of sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
